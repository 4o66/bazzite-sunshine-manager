#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Capture a SteamGridDB API key for the artwork picker.
#
# Run this from your own terminal. Get a key from
# https://www.steamgriddb.com/profile/preferences/api -- it is free, and it is
# what makes community artwork available for games Steam has no cover for.
#
# The key is read without echo and handed to the importer on stdin. Never as an
# argument: --sgdb-key puts it in ps output and in your shell history, which is
# exactly what this script exists to avoid. The importer checks it against the
# API before storing it mode 600, so a bad paste fails here rather than looking
# like "SteamGridDB has nothing for this game" later.
set -uo pipefail

for candidate in "$HOME/.local/bin/sunshine-import" \
                 "$HOME/.local/bin/bsm-test-import" \
                 "$(command -v sunshine-import 2>/dev/null)"; do
  [[ -n "$candidate" && -x "$candidate" ]] && IMPORTER="$candidate" && break
done
if [[ -z "${IMPORTER:-}" ]]; then
  echo "No sunshine-import found on PATH or in ~/.local/bin." >&2
  exit 1
fi

printf 'SteamGridDB API key: '
IFS= read -rs SGDB_KEY
printf '\n'

if [[ -z "$SGDB_KEY" ]]; then
  echo "No key given; nothing written." >&2
  exit 1
fi

# The wrapper is chatty on stderr; keep the last line, which is the verdict.
OUTPUT=$(printf '%s\n' "$SGDB_KEY" | "$IMPORTER" --save-sgdb-key 2>&1 >/dev/null)
status=$?
unset SGDB_KEY

if [[ $status -ne 0 ]]; then
  echo "${OUTPUT##*$'\n'}" >&2
  echo "Nothing was written." >&2
  exit 1
fi
echo "${OUTPUT##*$'\n'}"
echo "Nothing was echoed and no value appears in your shell history."
